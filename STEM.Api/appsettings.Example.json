{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_YOUR_POSTGRES_CONNECTION_STRING"
  },
  "JwtSettings": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET",
    "Issuer": "StemApi",
    "Audience": "StemClients",
    "ExpirationInHours": "24"
  },
  "EmailSettings": {
    "FromEmail": "REPLACE_WITH_SENDER_EMAIL",
    "FromName": "STEM Platform Support",
    "SmtpServer": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUser": "REPLACE_WITH_SMTP_USER",
    "SmtpPass": "REPLACE_WITH_SMTP_APP_PASSWORD"
  },
  "Supabase": {
    "Url": "REPLACE_WITH_SUPABASE_URL",
    "Key": "REPLACE_WITH_SUPABASE_ANON_KEY",
    "BucketName": "avatars"
  },
  "GoogleSettings": {
    "ClientId": "REPLACE_WITH_GOOGLE_CLIENT_ID",
    "ValidIssuers": [
      "https://accounts.google.com",
      "https://accounts.google.com/"
    ]
  },
  "Beeknoee": {
    "BaseUrl": "https://platform.beeknoee.com/api/v1",
    "Model": "claude-sonnet-4-6",
    "ApiKey": ""
  },
  "SimulationCompile": {
    "DockerCliPath": "docker",
    "DockerImage": "trieu77/stem-arduino-cli-sandbox:v1-esp32-2.0.17",
    "MemoryLimit": "1536m",
    "CpuLimit": "1.0",
    "PidsLimit": "128",
    "BuildTmpfsSizeMb": "256",
    "TimeoutSeconds": "90"
  },
  "SimulationRunner": {
    "DefaultMode": "qemu",
    "MaxDurationMs": 600000,
    "MaxInstructionCount": 600000,
    "MaxConcurrentRuns": 10,
    "Qemu": {
      "DockerImage": "stem-qemu-runner-sandbox:latest",
      "MemoryLimit": "512m",
      "CpuLimit": "1.0",
      "PidsLimit": "64",
      "MaxConcurrentRuns": 4
    }
  }
}
